# moss-tts-nano tts — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=moss-tts-nano
ENGINE_KIND=tts
PORT=8207
BIND_HOST=0.0.0.0

# ONNX 자산 디렉터리. 없으면 첫 기동 때 자동으로 받는다
# (MOSS-TTS-Nano-100M-ONNX + MOSS-Audio-Tokenizer-Nano-ONNX).
# 빈 값이면 저장소 기본 경로(=/models 볼륨으로 링크됨)를 쓰고 자산을 자동 다운로드한다.
MODEL_NAME=

# 이 엔진은 CPU 전용이다 (ONNX Runtime GPU 가 WSL/ROCm 에서 불가).
CPU_THREADS=4
MAX_NEW_FRAMES=375
SAMPLE_MODE=fixed

# 빈 값이면 첫 번째 내장 보이스를 쓴다. GET /v1/voices 로 목록 확인.
DEFAULT_VOICE=default

# WeTextProcessing 텍스트 정규화. pynini 소스 빌드가 필요해 기본은 끔.
ENABLE_WETEXT=0

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=4g
LOG_LEVEL=INFO
ACCESS_LOG=0
