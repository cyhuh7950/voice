# __ENGINE__ __KIND__ — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=__ENGINE__
ENGINE_KIND=__KIND__
PORT=__PORT__
BIND_HOST=0.0.0.0

# TODO: 엔진별 설정을 여기에 추가하고 server.py 에서 os.getenv 로 읽는다
MODEL_NAME=TODO

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# 외부에 열어두려면 반드시 채울 것 (Authorization: Bearer <키>)
API_KEY=

MEM_LIMIT=2g
LOG_LEVEL=INFO
ACCESS_LOG=0
