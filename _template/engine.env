# __ENGINE__ __KIND__ — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx, 화자는 83xx (관례일 뿐 종류 판단은 ENGINE_KIND 로 한다).

ENGINE_NAME=__ENGINE__
ENGINE_KIND=__KIND__
PORT=__PORT__
# voicectl.sh list 의 '모델' 칸에 어떤 키를 보여줄지. 값이 아니라 키 이름이다.
MODEL_KEY=MODEL_NAME
BIND_HOST=0.0.0.0

# TODO: 엔진별 설정을 여기에 추가하고 server.py 에서 os.getenv 로 읽는다
MODEL_NAME=TODO

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=2g
LOG_LEVEL=INFO
ACCESS_LOG=0
