# whisper stt — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=whisper
ENGINE_KIND=stt
PORT=8103
BIND_HOST=0.0.0.0

# transformers 용 원본 가중치다. faster-whisper 의 Systran/* (CTranslate2 변환본) 이 아니다.
MODEL_NAME=openai/whisper-large-v3
DEVICE=cuda
COMPUTE_TYPE=float16
BEAM_SIZE=5
CHUNK_LENGTH_S=30
BATCH_SIZE=8

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=8g
LOG_LEVEL=INFO
ACCESS_LOG=0
