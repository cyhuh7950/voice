# whisper STT — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 는 이 파일의 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 서비스를 자동 인식하고,
# docker compose 에 --env-file 로 그대로 넘긴다. 포트를 바꾸려면 여기만 고치면 된다.

ENGINE_NAME=whisper
ENGINE_KIND=stt
PORT=8101
# voicectl.sh list 의 '모델' 칸에 어떤 키를 보여줄지. 값이 아니라 키 이름이다.
MODEL_KEY=WHISPER_MODEL

# 0.0.0.0 이면 외부에서 접근 가능. 127.0.0.1 로 두면 서버 내부에서만.
BIND_HOST=127.0.0.1

# 모델 크기: tiny | base | small | medium | large-v3 (클수록 정확하고 느림)
# 이 서버(ARM 4코어)에서 base+int8 기준 RTF 약 1.1 로 측정됨.
WHISPER_MODEL=base
# int8(빠름/가벼움) | int8_float32 | float32(정확)
COMPUTE_TYPE=int8
# 1 = greedy 디코딩. 올리면 정확도가 조금 오르고 눈에 띄게 느려진다.
BEAM_SIZE=1
# 0 이면 CTranslate2 가 코어 수에 맞춰 자동 결정
CPU_THREADS=0
# 무음 구간을 잘라 처리량을 줄인다
VAD_FILTER=1

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# 외부에 열어두려면 반드시 채울 것. 값이 있으면 Authorization: Bearer <키> 가 필요해진다.
# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

# 컨테이너 메모리 상한
MEM_LIMIT=3g

LOG_LEVEL=INFO
ACCESS_LOG=0
HF_HOME=/models
