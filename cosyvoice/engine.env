# cosyvoice tts — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=cosyvoice
ENGINE_KIND=tts
PORT=8203
BIND_HOST=0.0.0.0

# /models 는 <엔진>/models/ 볼륨 마운트 (아래 "모델 다운로드" 참고)
MODEL_NAME=/models/Fun-CosyVoice3-0.5B
DEFAULT_VOICE=default

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
FP16=1
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=12g
LOG_LEVEL=INFO
ACCESS_LOG=0
