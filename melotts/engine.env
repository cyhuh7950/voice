# melotts TTS — 엔진 메타데이터 + 런타임 설정 (단일 소스)

ENGINE_NAME=melotts
ENGINE_KIND=tts
PORT=8202
BIND_HOST=127.0.0.1

# 이 컨테이너가 담당할 언어. 체크포인트가 언어별로 나뉘어 있어 하나만 고른다.
# 가능: EN ES FR ZH JP KR
MELO_LANGUAGE=KR
DEVICE=cpu

# 모델 캐시 (첫 기동 시 체크포인트 + BERT 를 받아 여기 쌓인다. 수백 MB~1GB)
HF_HOME=/models
NLTK_DATA=/opt/nltk_data

# 합성 파라미터 (MeloTTS 기본값)
SDP_RATIO=0.2
NOISE_SCALE=0.6
NOISE_SCALE_W=0.8

# torch 가 코어를 다 물지 않도록 제한. 다른 서비스와 같이 돌릴 때 특히 중요.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

PRELOAD=1
# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)
MAX_CHARS=5000
MEM_LIMIT=4g
LOG_LEVEL=INFO
ACCESS_LOG=0
