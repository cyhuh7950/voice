# fish-speech tts — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=fish-speech
ENGINE_KIND=tts
PORT=8206
BIND_HOST=0.0.0.0

# s2-pro 체크포인트 디렉터리. 첫 기동 때 /models 볼륨으로 받는다.
MODEL_NAME=/models/s2-pro
DECODER_CONFIG=modded_dac_vq
DEVICE=cuda

# HALF=1 이면 fp16, 0 이면 bf16. gfx1101 은 bf16 도 잘 돈다.
HALF=0
# torch.compile 은 ROCm 에서 첫 호출이 매우 느리고 실패 사례가 있어 기본은 끈다.
COMPILE=0
MAX_NEW_TOKENS=1024

# KV 캐시 길이 상한. 업스트림 기본값(config.max_seq_len=32768)은 캐시만 약 4.8GB 라
# 3B 가중치와 합치면 16GB VRAM 을 넘겨 기동이 OOM 으로 죽는다. 4096 이면 약 604MB.
# 긴 문장을 한 번에 합성해야 하면 올리되 VRAM 여유를 확인할 것.
MAX_SEQ_LEN=4096

# voices/<id>.wav (+ .txt 전사문) 참조 음성. S2 는 프리셋 음색이 없고 복제만 지원한다.
DEFAULT_VOICE=default

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=18g
LOG_LEVEL=INFO
ACCESS_LOG=0
