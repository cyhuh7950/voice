# whisper-streaming stt — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.
#
# 이 엔진만 WebSocket 엔드포인트를 추가로 연다: WS /v1/audio/stream
# 배치 엔진(whisper 8103)과 모델은 같고 확정 정책만 다르다.

ENGINE_NAME=whisper-streaming
ENGINE_KIND=stt
PORT=8104
BIND_HOST=0.0.0.0

MODEL_NAME=openai/whisper-large-v3
DEVICE=cuda
COMPUTE_TYPE=float16

# 스트리밍은 지연이 우선이라 빔서치를 쓰지 않는다(1 = greedy).
BEAM_SIZE=1

# 이만큼 새 오디오가 쌓일 때마다 한 번 추론한다.
# 짧을수록 반응이 빠르지만 같은 구간을 여러 번 다시 디코딩하므로 GPU 부담이 커진다.
CHUNK_SECONDS=1.0

# whisper 는 30초를 한 창으로 본다. 그 안쪽으로 유지해야 하므로 넘어가면 앞을 잘라낸다.
MAX_BUFFER_SECONDS=25.0

# 비워두면 매 추론마다 언어를 감지한다. 언어가 고정이면 지정하는 편이 빠르고 안정적이다.
DEFAULT_LANGUAGE=ko

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외).
# WebSocket 은 헤더를 못 붙이는 클라이언트를 위해 ?token=<키> 도 받는다.

MEM_LIMIT=8g
LOG_LEVEL=INFO
ACCESS_LOG=0
