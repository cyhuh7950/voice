# qwen3-tts tts — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=qwen3-tts
ENGINE_KIND=tts
PORT=8205
BIND_HOST=0.0.0.0

# CustomVoice = 프리셋 음색 9종. Base 로 바꾸면 참조 음성 zero-shot 복제 경로가 된다.
MODEL_NAME=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
DEVICE=cuda:0
COMPUTE_TYPE=bfloat16
DEFAULT_VOICE=Sohee
DEFAULT_LANGUAGE=ko

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=8g
LOG_LEVEL=INFO
ACCESS_LOG=0
