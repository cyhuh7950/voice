# zipformer stt — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=zipformer
ENGINE_KIND=stt
PORT=8105
BIND_HOST=0.0.0.0

# 비스트리밍(offline) 한국어 모델. 스트리밍판은 sherpa-onnx-streaming-zipformer-korean-2024-06-16.
MODEL_NAME=k2-fsa/sherpa-onnx-zipformer-korean-2024-06-24

# 이 엔진은 CPU 전용이다 (ONNX Runtime GPU 가 WSL/ROCm 에서 불가).
INT8=1
NUM_THREADS=4
DECODING_METHOD=greedy_search

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=2g
LOG_LEVEL=INFO
ACCESS_LOG=0
