# speaker 화자 임베딩 — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 는 이 파일의 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 서비스를 자동 인식한다.
# 종류 판단은 ENGINE_KIND 로만 한다 (포트 대역 83xx 는 사람이 보기 위한 관례일 뿐).

ENGINE_NAME=speaker
ENGINE_KIND=speaker
PORT=8301
# voicectl.sh list 의 '모델' 칸에 어떤 키를 보여줄지. 값이 아니라 키 이름이다.
MODEL_KEY=SPEAKER_MODEL_NAME
# 0.0.0.0 이면 외부에서 접근 가능. 127.0.0.1 로 두면 서버 내부에서만.
BIND_HOST=127.0.0.1

# ---- 모델 -------------------------------------------------------------------
# WeSpeaker ECAPA-TDNN(512) + Large-Margin fine-tune, VoxCeleb 학습. 출력 192차원.
# 첫 기동 때 아래 URL 에서 받아 /models 볼륨에 캐시한다 (약 24.8MB).
SPEAKER_MODEL_NAME=wespeaker-ecapa-tdnn512-LM
SPEAKER_MODEL_DIR=/models
SPEAKER_MODEL_FILE=voxceleb_ECAPA512_LM.onnx
# 받을 곳 후보(콤마 구분). 앞에서부터 시도하고, 각각 urllib → curl 두 경로를 쓴다.
# HuggingFace CDN 이 500 을 내거나 전송을 끊는 일이 잦아 미러를 하나 더 둔다.
# 전부 실패하면 받아둔 파일을 이 폴더의 models/ 에 직접 넣고 재시작하면 된다.
SPEAKER_MODEL_URLS=https://huggingface.co/Wespeaker/wespeaker-ecapa-tdnn512-LM/resolve/main/voxceleb_ECAPA512_LM.onnx,https://hf-mirror.com/Wespeaker/wespeaker-ecapa-tdnn512-LM/resolve/main/voxceleb_ECAPA512_LM.onnx
# 위 후보 전체를 한 바퀴 도는 것을 이만큼 반복한다.
DOWNLOAD_RETRIES=5
DOWNLOAD_RETRY_WAIT=3
DOWNLOAD_TIMEOUT=120
# 받다 만 파일이나 오류 HTML 을 모델로 착각하지 않도록 하는 하한(bytes)
SPEAKER_MODEL_MIN_BYTES=1000000

# ---- 특징 추출 ---------------------------------------------------------------
# 모델 학습 때와 같은 값이어야 한다. 하나라도 바꾸면 임베딩이 달라져 기존 등록본과 어긋난다.
SAMPLE_RATE=16000
FBANK_NUM_BINS=80
FBANK_FRAME_LENGTH_MS=25.0
FBANK_FRAME_SHIFT_MS=10.0
FBANK_WINDOW=hamming
FBANK_DITHER=0.0
FBANK_ENERGY_FLOOR=0.0
FBANK_SNIP_EDGES=1
# voiceapi 는 파형을 -1.0~1.0 으로 주는데 이 fbank 설정은 int16 스케일에서 검증됐다.
# 특징 추출 직전에 이 값을 곱해 스케일을 맞춘다. 바꾸면 임베딩이 전부 달라진다.
FEATURE_SCALE=32768.0
# 채널/마이크 차이를 지우는 평균 차감
APPLY_CMN=1
# 내적만으로 코사인 유사도가 되도록 L2 정규화해서 내보낸다
L2_NORMALIZE=1

# ---- 입력 길이 ---------------------------------------------------------------
# 짧은 발화는 임베딩이 불안정해 오인식이 는다. 미만이면 400 으로 거절한다.
MIN_AUDIO_SECONDS=1.0
MAX_AUDIO_SECONDS=60

# ---- 판정 기준 ---------------------------------------------------------------
# 같은 화자로 볼 코사인 유사도 하한. /info 로 알리고 /v1/speaker/compare 기본값이 된다.
# 이 서버 실측(supertonic 합성 음성, 2.4초): 같은 화자 0.72~0.80 / 다른 화자 0.20~0.42.
# 등록 화자만 통과시키는 게이트로 쓸 땐 0.5 부근에서 시작해 운영 데이터로 조정할 것.
SIMILARITY_THRESHOLD=0.5

# ONNX Runtime 스레드. 0 이면 런타임 자동. 다른 서비스와 CPU 를 나눠 쓸 땐 낮춘다.
INTRA_OP_THREADS=0
INTER_OP_THREADS=0

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1
# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)
MEM_LIMIT=2g
LOG_LEVEL=INFO
ACCESS_LOG=0
