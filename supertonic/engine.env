# supertonic TTS — 엔진 메타데이터 + 런타임 설정 (단일 소스)

ENGINE_NAME=supertonic
ENGINE_KIND=tts
PORT=8201
# voicectl.sh list 의 '모델' 칸에 어떤 키를 보여줄지. 값이 아니라 키 이름이다.
MODEL_KEY=SUPERTONIC_MODEL
BIND_HOST=127.0.0.1

# supertonic | supertonic-2 | supertonic-3 (기본값이 최신)
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_MODEL_DIR=/models
HF_HOME=/models/hf

# 요청에 voice / language 가 없을 때 쓰는 기본값
# 보이스: M1~M5(남) F1~F5(여) — 목록은 GET /v1/voices
DEFAULT_VOICE=F1
# 31개 언어 지원. 'na' 는 언어 자동 처리.
DEFAULT_LANGUAGE=ko

# 5(빠름) ~ 12(고품질).
# 실측(ARM 4코어, 2.09초 영어 문장): 8 → 3.97s, 6 → 3.26s, 5 → 2.71s
# 5 는 한국어 발음이 뭉개진다 ("품질을" → "크림지를" 로 역인식됨). 6 이 품질을 지키는 하한.
TOTAL_STEPS=6
SAMPLE_RATE=44100

# ONNX Runtime 스레드. 0 이면 런타임 자동. 다른 서비스와 CPU 를 나눠 쓸 땐 낮춘다.
INTRA_OP_THREADS=0
INTER_OP_THREADS=0

PRELOAD=1
# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)
MAX_CHARS=5000
MEM_LIMIT=3g
LOG_LEVEL=INFO
ACCESS_LOG=0
