# moonshine STT — 엔진 메타데이터 + 런타임 설정 (단일 소스)

ENGINE_NAME=moonshine
ENGINE_KIND=stt
PORT=8102
# voicectl.sh list 의 '모델' 칸에 어떤 키를 보여줄지. 값이 아니라 키 이름이다.
MODEL_KEY=MOONSHINE_LANGUAGE
BIND_HOST=127.0.0.1

# 이 컨테이너가 담당할 언어. 모델이 언어별로 분리돼 있어 하나만 고른다.
# 가능: ar es en ja ko vi uk zh
#
# 실측 주의 — 한국어는 tiny 모델만 존재하고, 문장 끝 단어를 자주 놓친다.
#   "오라클 서버에서 음성 합성이 동작합니다." → "오라클 서버에서 음성 합성이"
#   "안녕하세요, 음성 번역 테스트입니다."     → "안녕하세요. 음성 번역"
# 배치/스트리밍/FORCE_UPDATE 세 경로 모두 동일했고, 같은 파일을 whisper 는 완전히 인식했다.
# 즉 API 문제가 아니라 tiny-ko 모델 한계다. 한국어 정확도가 필요하면 whisper(8101)를 쓸 것.
# 영어(tiny/base)는 같은 조건에서 문장을 완전히 인식했다.
MOONSHINE_LANGUAGE=ko
# 빈 값 = 해당 언어의 기본 아키텍처.
# 주의: en 기본값은 medium_streaming(245M) 으로 무겁다. 가볍게 쓰려면 tiny 로 지정.
# 가능: tiny base tiny_streaming base_streaming small_streaming medium_streaming
MOONSHINE_ARCH=

# 모델 캐시 위치 (moonshine 은 <APP>_CACHE 환경변수를 본다)
MOONSHINE_VOICE_CACHE=/models

PRELOAD=1
# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)
MEM_LIMIT=2g
LOG_LEVEL=INFO
ACCESS_LOG=0
