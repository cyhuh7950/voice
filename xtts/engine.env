# xtts tts — 엔진 메타데이터 + 런타임 설정 (단일 소스)
#
# voicectl.sh 가 ENGINE_NAME / ENGINE_KIND / PORT 를 읽어 자동 인식한다.
# 포트 규칙: STT 는 81xx, TTS 는 82xx.

ENGINE_NAME=xtts
ENGINE_KIND=tts
PORT=8204
BIND_HOST=0.0.0.0

MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
DEVICE=cuda
DEFAULT_LANGUAGE=ko

# 기본값을 내장 화자로 둔다. voices/*.wav 참조 음성 복제도 되지만,
# XTTS-v2 는 참조가 짧으면(6초 미만) 생성이 붕괴한다 — 실측에서 4.17초 참조로
# "안녕하세요"가 200회 넘게 반복되는 출력이 나왔다. 복제를 쓰려면 6초 이상, 되도록
# 10초 이상의 깨끗한 음성을 voices/ 에 넣고 그 id 를 지정할 것.
# GET /v1/voices 로 목록 확인 (참조 음성 + 내장 화자 58종).
DEFAULT_VOICE=Andrew Chipper

# 가중치가 CPML 이라 라이브러리가 대화형 동의를 요구한다. 컨테이너에는 tty 가 없어
# 이 값이 없으면 기동이 멈춘다. (server.py 에도 기본값을 넣어뒀다)
COQUI_TOS_AGREED=1

# 1 = 기동 시 모델 미리 로드 / 0 = 첫 요청까지 메모리 아낌
PRELOAD=1

# API_KEY 는 secrets.env 로 분리했다 (버전관리 제외)

MEM_LIMIT=8g
LOG_LEVEL=INFO
ACCESS_LOG=0
